<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="kcalCalculator.Views.AboutWindow"
        Title="Про застосунок"
        Width="400" Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1e1e1e"
        Icon="/Assets/icons8-корзина-64.png">
    
    <Border Padding="20">
        <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <TextBlock Text="Калькулятор Оптимального Кошика" 
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#0078D7"/>
            
            <TextBlock Text="Курсова робота з ООП" 
                       FontSize="14" HorizontalAlignment="Center" Foreground="Gray" Margin="0,-10,0,10"/>

            <Border CornerRadius="100" ClipToBounds="True" Width="120" Height="120" 
                    BorderBrush="#0078D7" BorderThickness="2" Background="White">
                <Image Source="/Assets/DSC_9293.JPG" Stretch="UniformToFill">
                    <Image.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </Image.RenderTransform>
                </Image>
            </Border>

            <TextBlock Text="Розробник:" HorizontalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
            
            <TextBlock Text="Вдовенко Антон Ігорович" 
                       FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
            
            <TextBlock Text="Група: КС-24" HorizontalAlignment="Center" Foreground="White"/>
            
            <TextBlock Text="Черкаський національний університет&#x0a;ім. Б. Хмельницького" 
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>

            <Button Content="Закрити" Click="CloseButton_Click" 
                    HorizontalAlignment="Center" Width="120" HorizontalContentAlignment="Center" 
                    Background="#851F0D" Foreground="White" FontWeight="Bold" Margin="0,20,0,0"/>
            
        </StackPanel>
    </Border>
</Window>